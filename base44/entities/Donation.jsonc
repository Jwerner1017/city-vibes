{
  "name": "Donation",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "one_time",
        "monthly"
      ]
    },
    "tier_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "cancelled"
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray"
      ],
      "default": "pending"
    },
    "user_id": {
      "type": "string",
      "description": "The signed-in donor. Set by the server when checkout starts."
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe checkout session this donation was started with."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "amount",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}